{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "local>PinguApps/renovate-config"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "dotnet tool install -g Aspire\\.Cli --version (?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "nuget",
      "depNameTemplate": "Aspire.Cli",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)(samples/TypeScriptAppHost|tests/Aspire\\.Hosting\\.Dashboard\\.Railway/Fixtures/TypeScriptAppHost)/aspire\\.config\\.json$/"
      ],
      "matchStrings": [
        "\"sdk\"\\s*:\\s*\\{\\s*\"version\"\\s*:\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "nuget",
      "depNameTemplate": "Aspire.Cli",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)AGENTS\\.md$/"
      ],
      "matchStrings": [
        "Target Aspire version:\\s*`(?<currentValue>[^`]+)`"
      ],
      "datasourceTemplate": "nuget",
      "depNameTemplate": "Aspire.Hosting",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)(samples/TypeScriptAppHost|tests/Aspire\\.Hosting\\.Dashboard\\.Railway/Fixtures/TypeScriptAppHost)/aspire\\.config\\.json$/"
      ],
      "matchStrings": [
        "\"(?<depName>Aspire\\.Hosting\\.Dotnet|PinguApps\\.Aspire\\.Hosting\\.Railway)\"\\s*:\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "nuget",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^README\\.md$/",
        "/^docs/(?:install|getting-started-typescript|repository-setup)\\.md$/"
      ],
      "matchStrings": [
        "(?:Aspire |set `sdk\\.version` to )(?<currentValue>\\d+\\.\\d+\\.\\d+)(?:[ /.,]|$)"
      ],
      "datasourceTemplate": "nuget",
      "versioningTemplate": "semver",
      "depNameTemplate": "Aspire.Hosting"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^README\\.md$/",
        "/^docs/(?:install|getting-started-typescript|repository-setup)\\.md$/"
      ],
      "matchStrings": [
        "\"PinguApps\\.Aspire\\.Hosting\\.Railway\"\\s*:\\s*\"(?<currentValue>[^\"]+)\"",
        "`PinguApps\\.Aspire\\.Hosting\\.Railway` (?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "nuget",
      "versioningTemplate": "semver",
      "depNameTemplate": "PinguApps.Aspire.Hosting.Railway"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "/^Aspire(?:\\.|$)/i",
        "mcr.microsoft.com/aspire/dashboard",
        "mcr.microsoft.com/dotnet/aspire-dashboard"
      ],
      "enabled": false
    }
  ]
}
